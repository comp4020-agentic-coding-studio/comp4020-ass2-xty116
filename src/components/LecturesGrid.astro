---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { formatCourseDate } from "../lib/dates";

const lectures = await getPublishedCollection("lectures");
const visible = lectures.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<ol class="observation-index">
  {
    visible.map((lecture) => (
      <li>
        <a href={withBase(`/lectures/${lecture.id}/`)}>
          <span class="observation-week">W{String(lecture.data.week).padStart(2, "0")}</span>
          <span class="observation-title"><strong>{lecture.data.title}</strong><small>{lecture.data.question}</small></span>
          <span class="observation-object"><b>DATA OBJECT</b>{lecture.data.dataObject}</span>
          <time datetime={lecture.data.date.toISOString()}>{formatCourseDate(lecture.data.date)}</time>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .observation-index { margin: 2rem 0; padding: 0; border-block: 1px solid var(--course-line-strong); list-style: none; }
  .observation-index li + li { border-block-start: 1px solid var(--at-divider); }
  .observation-index a { display: grid; grid-template-columns: 3.2rem minmax(14rem, 1.25fr) minmax(10rem, 0.65fr) 8.5rem; gap: 1rem; align-items: center; padding: 1.25rem 0; color: inherit; text-decoration: none; }
  .observation-week { color: var(--course-cyan); font-family: var(--at-font-mono); font-size: 0.72rem; font-weight: 700; }
  .observation-title strong, .observation-title small, .observation-object b { display: block; }
  .observation-title strong { color: var(--course-paper); font-size: 1.08rem; }
  .observation-title small { margin-block-start: 0.35rem; color: var(--at-text-secondary); line-height: 1.35; }
  .observation-object { color: var(--at-text-secondary); font-size: 0.78rem; }
  .observation-object b { margin-block-end: 0.3rem; color: var(--at-text-muted); font-family: var(--at-font-mono); font-size: 0.62rem; }
  .observation-index time { color: var(--at-text-muted); font-family: var(--at-font-mono); font-size: 0.7rem; text-align: right; }
  .observation-index a:hover { background: color-mix(in srgb, var(--course-cyan) 5%, transparent); }
  @media (max-width: 48rem) {
    .observation-index a { grid-template-columns: 2.6rem 1fr; }
    .observation-object, .observation-index time { grid-column: 2; text-align: left; }
  }
</style>
