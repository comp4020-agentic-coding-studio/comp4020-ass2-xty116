---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import { formatCourseDate } from "../lib/dates";

const sessions = await getPublishedCollection("sessions");
const visible = sessions.sort((a, b) => a.data.week - b.data.week);
---

<ol class="lab-index">
  {
    visible.map((session) => (
      <li>
        <a href={withBase(`/sessions/${session.id}/`)}>
          <span class="lab-week">LAB {String(session.data.week).padStart(2, "0")}</span>
          <span class="lab-copy"><strong>{session.data.title}</strong><small>{session.data.description}</small></span>
          <span class="lab-output"><b>LEAVE WITH</b>{session.data.output}</span>
          <time datetime={session.data.date.toISOString()}>{formatCourseDate(session.data.date)}</time>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .lab-index { margin: 2rem 0; padding: 0; border-block: 1px solid var(--course-line-strong); list-style: none; }
  .lab-index li + li { border-block-start: 1px solid var(--at-divider); }
  .lab-index a { display: grid; grid-template-columns: 4.3rem minmax(14rem, 1.1fr) minmax(12rem, 0.9fr) 8.5rem; gap: 1rem; align-items: center; padding: 1.25rem 0; color: inherit; text-decoration: none; }
  .lab-week { color: var(--course-coral); font-family: var(--at-font-mono); font-size: 0.68rem; font-weight: 700; }
  .lab-copy strong, .lab-copy small, .lab-output b { display: block; }
  .lab-copy strong { color: var(--course-paper); font-size: 1.08rem; }
  .lab-copy small { margin-block-start: 0.35rem; color: var(--at-text-secondary); line-height: 1.35; }
  .lab-output { color: var(--at-text-secondary); font-size: 0.78rem; }
  .lab-output b { margin-block-end: 0.3rem; color: var(--at-text-muted); font-family: var(--at-font-mono); font-size: 0.62rem; }
  .lab-index time { color: var(--at-text-muted); font-family: var(--at-font-mono); font-size: 0.7rem; text-align: right; }
  .lab-index a:hover { background: color-mix(in srgb, var(--course-coral) 5%, transparent); }
  @media (max-width: 48rem) {
    .lab-index a { grid-template-columns: 3.4rem 1fr; }
    .lab-output, .lab-index time { grid-column: 2; text-align: left; }
  }
</style>
