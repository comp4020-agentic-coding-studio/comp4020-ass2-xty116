---
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";

const lectures = (await getPublishedCollection("lectures")).sort((a, b) => a.data.week - b.data.week);
const sessions = await getPublishedCollection("sessions");
const labByWeek = new Map(sessions.map((session) => [session.data.week, session]));
const signalShapes = [
  [38, 54, 62, 35, 18, 42, 66, 58],
  [22, 28, 31, 48, 52, 61, 44, 72],
  [18, 25, 42, 38, 64, 51, 77, 69],
  [16, 24, 75, 28, 18, 22, 71, 32],
  [21, 29, 33, 83, 78, 37, 44, 31],
  [12, 17, 24, 39, 58, 84, 96, 31],
  [18, 21, 31, 72, 41, 29, 82, 24],
  [14, 18, 67, 26, 22, 31, 73, 29],
  [58, 53, 47, 34, 12, 38, 51, 55],
  [61, 52, 44, 27, 31, 48, 59, 64],
  [31, 47, 39, 56, 44, 63, 51, 58],
  [22, 39, 57, 48, 72, 64, 82, 91],
];
const phases = [
  { label: "I", title: "Read the chain", weeks: [1, 2, 3, 4], note: "Signal, provenance, mapping and periodicity" },
  { label: "II", title: "Work across media", weeks: [5, 6, 7, 8], note: "Radio, strain, images and spectra" },
  { label: "III", title: "Make a public claim", weeks: [9, 10, 11, 12], note: "Uncertainty, access, rhetoric and release" },
];
---

<div class="course-atlas">
  {phases.map((phase) => (
    <section class="atlas-phase" aria-labelledby={`phase-${phase.label}`}>
      <header>
        <span>{phase.label}</span>
        <div><h3 id={`phase-${phase.label}`}>{phase.title}</h3><p>{phase.note}</p></div>
      </header>
      <ol>
        {phase.weeks.map((week) => {
          const lecture = lectures.find((entry) => entry.data.week === week);
          const lab = labByWeek.get(week);
          if (!lecture || !lab) return null;
          return (
            <li>
              <a href={withBase(`/lectures/${lecture.id}/`)}>
                <span class="atlas-week">W{String(week).padStart(2, "0")}</span>
                <span class="atlas-copy">
                  <strong>{lecture.data.title}</strong>
                  <small>{lecture.data.question}</small>
                </span>
                <span class="atlas-signal" aria-hidden="true">
                  {signalShapes[week - 1].map((height) => <i style={`--h:${height}%`}></i>)}
                </span>
                <span class="atlas-object"><b>DATA</b>{lecture.data.dataObject}</span>
                <span class="atlas-output"><b>LAB OUTPUT</b>{lab.data.output}</span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>
  ))}
</div>

<style>
  .course-atlas { margin-block: 2rem 5rem; border-block: 1px solid var(--course-line-strong); }
  .atlas-phase { display: grid; grid-template-columns: minmax(13rem, 0.42fr) minmax(0, 1.58fr); }
  .atlas-phase + .atlas-phase { border-block-start: 1px solid var(--course-line-strong); }
  .atlas-phase > header { display: grid; grid-template-columns: 2rem 1fr; gap: 1rem; align-content: start; padding: 1.6rem 1.6rem 1.6rem 0; }
  .atlas-phase > header > span { color: var(--course-gold); font-family: var(--at-font-mono); font-size: 0.75rem; }
  .atlas-phase h3 { margin: 0; color: var(--course-paper); font-size: 1.35rem; }
  .atlas-phase header p { margin: 0.4rem 0 0; color: var(--at-text-muted); font-size: 0.86rem; }
  .atlas-phase ol { margin: 0; padding: 0; border-inline-start: 1px solid var(--at-border); list-style: none; }
  .atlas-phase li + li { border-block-start: 1px solid var(--at-divider); }
  .atlas-phase a { display: grid; grid-template-columns: 3rem minmax(12rem, 1.3fr) 7rem minmax(9rem, 0.75fr) minmax(11rem, 0.9fr); gap: 1rem; align-items: center; min-height: 7.3rem; padding: 1rem 0 1rem 1.4rem; color: inherit; text-decoration: none; transition: background-color 160ms ease; }
  .atlas-phase a:hover { background: color-mix(in srgb, var(--course-cyan) 6%, transparent); }
  .atlas-week { color: var(--course-cyan); font-family: var(--at-font-mono); font-size: 0.7rem; font-weight: 700; }
  .atlas-copy strong, .atlas-copy small, .atlas-object, .atlas-output { display: block; }
  .atlas-copy strong { color: var(--course-paper); font-size: 1rem; }
  .atlas-copy small { margin-block-start: 0.3rem; color: var(--at-text-secondary); line-height: 1.35; }
  .atlas-object, .atlas-output { color: var(--at-text-secondary); font-size: 0.76rem; line-height: 1.35; }
  .atlas-object b, .atlas-output b { display: block; margin-block-end: 0.3rem; color: var(--at-text-muted); font-family: var(--at-font-mono); font-size: 0.6rem; }
  .atlas-signal { display: flex; align-items: end; gap: 0.24rem; height: 2.6rem; padding-block-end: 0.25rem; border-block-end: 1px solid color-mix(in srgb, var(--course-cyan) 45%, transparent); }
  .atlas-signal i { flex: 1; height: var(--h); min-height: 2px; background: linear-gradient(var(--course-gold), var(--course-cyan)); }

  @media (max-width: 68rem) {
    .atlas-phase { grid-template-columns: 1fr; }
    .atlas-phase > header { padding-inline: 0; }
    .atlas-phase ol { border-inline-start: 0; border-block-start: 1px solid var(--at-border); }
    .atlas-phase a { grid-template-columns: 3rem minmax(12rem, 1fr) 6rem minmax(10rem, 0.8fr); }
    .atlas-output { display: none; }
  }

  @media (max-width: 44rem) {
    .atlas-phase a { grid-template-columns: 2.5rem 1fr; gap: 0.6rem 0.85rem; min-height: 0; padding: 1rem 0; }
    .atlas-signal, .atlas-object { grid-column: 2; }
    .atlas-signal { width: 8rem; }
    .atlas-output { display: block; grid-column: 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .atlas-phase a { transition: none; }
  }
</style>
