---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import heroImage from "../assets/images/hero-universe.png";
import ListeningLab from "../components/ListeningLab.astro";
import SignalTelemetry from "../components/SignalTelemetry.astro";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
import "../styles/course.css";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="Radio telescope dishes beneath a measured night sky, with warm instrument light in the foreground"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <SignalTelemetry />

  <section class="course-thesis" aria-labelledby="thesis-title">
    <p class="eyebrow">The course position</p>
    <h2 id="thesis-title">Data does not sing by itself.</h2>
    <p>A telescope records measurements, not music. Every sound you make in this course must reveal its source, mapping and uncertainty, so a listener can tell what belongs to the universe and what belongs to your design.</p>
  </section>

  <section aria-labelledby="signal-chain-title">
    <p class="eyebrow">A repeatable method</p>
    <h2 id="signal-chain-title">The signal chain</h2>
    <ol class="signal-chain">
      <li><strong>Observe</strong><span>Find the measured quantity and its limits.</span></li>
      <li><strong>Map</strong><span>Choose what becomes pitch, time, timbre or space.</span></li>
      <li><strong>Listen</strong><span>Test what a listener can actually distinguish.</span></li>
      <li><strong>Disclose</strong><span>Publish the values, operations and uncertainty.</span></li>
    </ol>
  </section>

  <section aria-labelledby="lab-preview-title">
    <p class="eyebrow">Try the method</p>
    <h2 id="lab-preview-title">Listening Lab: one curve, two mappings</h2>
    <p>This synthetic teaching curve contains a small transit-like dip. Compare a pitch mapping with a rhythm mapping, then inspect the same values without sound.</p>
    <ListeningLab compact />
  </section>

  <section aria-labelledby="semester-title">
    <p class="eyebrow">Semester 2 · 12 weeks</p>
    <h2 id="semester-title">From first signal to public instrument</h2>
    <div class="semester-arc">
      <p><strong>Weeks 1–4</strong><span>Learn the grammar: samples, scales, time and pulsars.</span></p>
      <p><strong>Weeks 5–8</strong><span>Work with solar radio, gravitational waves, images and spectra.</span></p>
      <p><strong>Weeks 9–12</strong><span>Expose uncertainty, test accessibility and open the listening room.</span></p>
    </div>
  </section>

  <h2>Enter the course</h2>
  <CardGrid columns={2}>
    <Card title="Lectures" href="/lectures/"><p>Twelve questions, twelve astronomical data objects, one traceable argument.</p></Card>
    <Card title={sessionLabels.plural} href="/sessions/"><p>Weekly making sessions with a concrete output and an observable specification.</p></Card>
    <Card title="Assessment" href="/assessments/"><p>Four staged submissions that build towards an accountable listening instrument.</p></Card>
    <Card title="Open Listening Lab" href="/lab/"><p>Play the full teaching instrument and compare its mappings.</p></Card>
  </CardGrid>
</ContentLayout>
